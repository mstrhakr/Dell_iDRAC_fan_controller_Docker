# Copy this file to .env and fill in your values.
# Then use it with `docker run --env-file .env ...` or the `env_file: .env` directive in docker-compose.yml
# See the "Parameters" section of the README for details about each variable.

IDRAC_HOST=local
# Local mode needs an exposed IPMI device. For LAN mode set IDRAC_HOST to the
# iDRAC address and supply both credentials; neither has a default.
# IDRAC_USERNAME=
# IDRAC_PASSWORD=
# Startup-only profile: quiet, balanced (default), performance, or manual.
# FAN_PROFILE=balanced
# Automatic PID fan control is enabled by default. Set false to use FAN_SPEED instead.
# AUTO_MODE=false
# Normal automatic ramps, in percentage points per second (+2/-1 per 5s check).
# Raw overtemperature bypasses the slow upward ramp.
# FAN_RAMP_UP=0.4
# FAN_RAMP_DOWN=0.2
# Separate auto floor and static duty. Validate chassis airflow on your hardware.
# AUTO_MODE_FAN_SPEED_MIN=10
# FAN_SPEED=10
# Balanced profile supplies 70C CPU threshold; "auto" explicitly means 60C,
# not hardware detection. Critical limits default to threshold +10C (max 125C).
# CPU_TEMPERATURE_THRESHOLD=70
# CPU_CRITICAL_TEMPERATURE=80
# GPU_TEMPERATURE_SOURCE=disabled
# GPU_TEMPERATURE_THRESHOLD=80
# GPU_CRITICAL_TEMPERATURE=90
# CHECK_INTERVAL=5s
# LOG_INTERVAL=25s
# IPMI_COMMAND_TIMEOUT=10s
# MAXIMUM_IPMI_UNREACHABLE_DURATION=60s
# Set the duration deliberately empty to disable failed-read escalation.
# MAXIMUM_IPMI_UNREACHABLE_DURATION=
# MAXIMUM_CONSECUTIVE_IPMI_FAILURES=12
# MONITORING_ONLY_MODE=false
# VERBOSE_CYCLE_LOGGING=false
# ENABLE_DASHBOARD=false
# DASHBOARD_LISTEN_ADDRESS=:8080
# DASHBOARD_SAMPLE_LIMIT=300
